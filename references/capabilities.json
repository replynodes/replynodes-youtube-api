{
  "name": "replynodes-youtube-api",
  "version": "1.0.0",
  "base_url": "https://mcp.replynodes.com/mcp",
  "protocol": "MCP Streamable HTTP",
  "auth": ["ReplyNodes MCP OAuth or Bearer API key"],
  "mode": "research",
  "tools": [
    {"name":"youtube_search","capability":"public keyword search"},
    {"name":"youtube_video","capability":"public video metadata"},
    {"name":"youtube_channel","capability":"public channel metadata"},
    {"name":"youtube_comments","capability":"public video comments"},
    {"name":"youtube_playlist","capability":"public playlist metadata"},
    {"name":"youtube_related","capability":"related videos"},
    {"name":"youtube_transcript","capability":"public captions or transcript segments when available"}
  ]
}
